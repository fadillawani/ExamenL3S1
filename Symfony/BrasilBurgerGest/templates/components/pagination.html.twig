{% if nbPages > 0 %}
<nav class="mt-4">
  <ul class="pagination justify-content-center">
    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
      <a class="page-link"
         href="{{ path(route, app.request.query.all|merge({'page': currentPage - 1})) }}">
        Précédent
      </a>
    </li>

    {% for i in 1..nbPages %}
      <li class="page-item {% if i == currentPage %}active{% endif %}">
        <a class="page-link"
           href="{{ path(route, app.request.query.all|merge({'page': i})) }}">
          {{ i }}
        </a>
      </li>
    {% endfor %}

    <li class="page-item {% if currentPage == nbPages %}disabled{% endif %}">
      <a class="page-link"
         href="{{ path(route, app.request.query.all|merge({'page': currentPage + 1})) }}">
        Suivant
      </a>
    </li>
  </ul>
</nav>
{% endif %}
