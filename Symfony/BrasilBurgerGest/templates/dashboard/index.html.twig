{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">

    <h2 class="fw-bold mb-4">Tableau de bord – Statistiques du jour</h2>

    <!-- =======================
         Cartes statistiques
    ======================== -->
    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Commandes en cours</h6>
                    <h2 class="fw-bold text-warning">{{ enCours }}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Commandes validées</h6>
                    <h2 class="fw-bold text-success">{{ validees }}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Commandes annulées</h6>
                    <h2 class="fw-bold text-danger">{{ annulees }}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Recettes journalières</h6>
                    <h2 class="fw-bold text-primary">
                        {{ recettes|number_format(0, ',', ' ') }} FCFA
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- =======================
         Burgers les plus vendus
    ======================== -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">
            Burgers les plus vendus aujourd’hui
        </div>

        <div class="card-body">

            {% if topBurgers is empty %}
                <p class="text-muted mb-0">Aucune vente enregistrée aujourd’hui.</p>
            {% else %}
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Burger</th>
                            <th class="text-end">Quantité vendue</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in topBurgers %}
                            <tr>
                                <td>{{ item.burger }}</td>
                                <td class="text-end fw-bold">{{ item.totalVendus }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
