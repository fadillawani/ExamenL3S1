{% extends "base.html.twig" %}

{% block body %}

<div class="container mt-5">

  <!-- Titre -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Liste des commandes</h2>
  </div>

  {% include 'components/messagesflash.html.twig' %}

  <!-- Tableau -->
  <div class="card shadow-sm rounded-4 p-3">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">

        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Client</th>
            <th>Prix total</th>
            <th>Statut</th>
            <th>Paiement</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>

        <tbody>
        {% for commande in commandes %}
          <tr>
            <td>{{ commande.id }}</td>

            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>

            <td>{{ commande.emailClient }}</td>

            <td>{{ commande.prixTotal|number_format(0, ',', ' ') }} FCFA</td>

            <!-- Statut -->
            <td>
              {% if commande.etat == 'EN_ATTENTE' %}
                <span class="badge bg-warning text-dark">En attente</span>
              {% elseif commande.etat == 'VALIDEE' %}
                <span class="badge bg-success">Validée</span>
              {% elseif commande.etat == 'TERMINEE' %}
                <span class="badge bg-primary">Terminée</span>
              {% elseif commande.etat == 'ANNULEE' %}
                <span class="badge bg-danger">Annulée</span>
              {% else %}
                <span class="badge bg-secondary">{{ commande.etat }}</span>
              {% endif %}
            </td>

            <!-- Paiement -->
            <td>
              {% if commande.paiements|length > 0 %}
                <span class="badge bg-success">Oui</span>
              {% else %}
                <span class="badge bg-secondary">Non</span>
              {% endif %}
            </td>

            <!-- Actions -->
            <td class="text-center text-nowrap">

              <!-- Détails -->
              <a href="{{ path('app_commande_detail', {id: commande.id}) }}"
                 class="btn btn-sm btn-primary"
                 title="Voir les détails">
                <i class="bi bi-eye"></i>
              </a>

              {% if commande.etat == 'EN_ATTENTE' %}
                <!-- Valider -->
                <a href="{{ path('app_commande_valider', {id: commande.id}) }}"
                   class="btn btn-sm btn-success mx-1"
                   title="Valider la commande">
                  <i class="bi bi-check-circle"></i>
                </a>

                <!-- Annuler -->
                <a href="{{ path('app_commande_annuler', {id: commande.id}) }}"
                   class="btn btn-sm btn-danger"
                   title="Annuler la commande"
                   onclick="return confirm('Confirmer l\'annulation ?')">
                  <i class="bi bi-x-circle"></i>
                </a>
              {% else %}
                <span class="badge bg-secondary ms-2">Aucune action</span>
              {% endif %}

            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center text-muted">
              Aucune commande trouvée
            </td>
          </tr>
        {% endfor %}
        </tbody>

      </table>
    </div>
  </div>

  <!-- Pagination -->
  {% include 'components/pagination.html.twig' with {
    currentPage: currentPage,
    nbPages: nbPages,
    route: paginationRoute,
    params: paginationParams
  } %}

</div>

{% endblock %}
