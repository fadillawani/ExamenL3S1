<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-papF4D2i6a1XG5R+4I5zXd77e4nJ6p3Z8yGqXK4F7j7A7d1XzV/njST8l2Bdms5r45gYhJY5n9BIP5X9vLg3QA==" crossorigin="anonymous" referrerpolicy="no-referrer" />


    <title>@ViewData["Title"] - Brasil Burger</title>

    <!-- Bootstrap (utile plus tard, mais pas imposant) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS global -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- NAVBAR PERSONNALISÉE -->
    @await Html.PartialAsync("Navbar")

    <!-- CONTENU DES PAGES -->
    @RenderBody()

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
