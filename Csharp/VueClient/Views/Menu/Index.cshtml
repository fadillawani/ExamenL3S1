@model IEnumerable<Menu>

@{
    ViewData["Title"] = "Nos Menus";
}

<section class="bb-burgers-header">
    <h1>
        NOS <span>MENUS</span>
    </h1>
</section>

<section class="bb-menus-section">
    <div class="bb-menus-grid">

        @foreach (var menu in Model)
        {
            <div class="bb-menu-card">
                <img src="@menu.image_url"
                     alt="@menu.libelle" />

                <h3>@menu.libelle</h3>

                <ul class="bb-menu-details">

                        @* Burgers du menu *@
                        @foreach (var mb in menu.menu_burger)
                        {
                            <li>@mb.burger.libelle</li>
                        }

                        @* Compléments du menu *@
                        @foreach (var mc in menu.menu_complement)
                        {
                            <li>@mc.complement.libelle</li>
                        }


                </ul>

                <div class="bb-menu-footer">
                    <span class="price">
                        @menu.prix.ToString("0") FCFA
                    </span>

                    <a asp-action="Commander"
                       asp-route-id="@menu.id"
                       class="order-btn">
                        COMMANDER
                    </a>
                </div>
            </div>
        }

    </div>
</section>
