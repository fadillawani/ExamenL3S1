@{
    ViewData["Title"] = "Accueil";
}

<!-- HERO -->
<section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-radial"></div>

    <div class="hero-container">
        <div class="hero-grid">

            <!-- Texte -->
            <div class="hero-content">
                <h1>
                    BRASIL<br>
                    <span>BURGER</span>
                </h1>

                <p>
                    Découvrez nos burgers gourmands préparés avec des ingrédients frais et de qualité.
                </p>

                <div class="hero-actions">
                    <a href="/Burger" class="btn btn-secondary">
                        🍔 Catalogue Burgers
                    </a>
                    <a href="/Menu" class="btn btn-outline">
                        📖 Catalogue Menus
                    </a>
                </div>
            </div>

            <!-- Image -->
            <div class="hero-image">
                <div class="hero-glow"></div>
                <img src="/wwwroot/Images/burger-hero(1).jpg" alt="Burger Brasil Burger">
            </div>

        </div>
    </div>

  
</section>


<!-- FOOTER -->
<footer class="footer">
    <div class="footer-brand">
        <div class="logo">BB</div>
        <span>Brasil Burger</span>
    </div>
    <p>© 2024 Brasil Burger. Tous droits réservés.</p>
</footer>
